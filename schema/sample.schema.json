{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xiaoyuan0459/qingyu-handwriting-dataset/main/schema/sample.schema.json",
  "title": "Qingyu handwriting trajectory sample",
  "description": "One line of a JSONL file. Semantic checks such as monotonic timestamps and unique ids are described in docs/sample-format.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "label",
    "canvas",
    "strokes"
  ],
  "properties": {
    "format": {
      "const": "qingyu-hw-trajectory"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2,
      "description": "A single Han character in v1, Unicode NFC."
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect",
        "unit"
      ],
      "properties": {
        "aspect": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "const": "normalized"
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "const": "android"
        },
        "app_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "screen_density": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "strokes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2048,
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0
            }
          ],
          "items": false
        }
      }
    }
  }
}
